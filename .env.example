# Copy to .env.local for local development. Never commit real values.

# Set automatically on Vercel when you connect a Neon database (Storage tab).
# For local dev, run `vercel env pull .env.local` or paste it from the Neon dashboard.
DATABASE_URL=

# Demo account created/updated on every build (plan = pro).
DEMO_EMAIL=
DEMO_PASSWORD=

# AI feature (school matching + coach emails). Create at console.anthropic.com.
ANTHROPIC_API_KEY=
